<style>
.page-404 {
  max-width: 600px;
  margin: 60px auto;
  padding: 40px 20px;
  text-align: center;
}
.page-404 h1 {
  font-size: 80px;
  font-weight: bold;
  margin: 0 0 20px 0;
}
.page-404 h2 {
  font-size: 32px;
  margin: 0 0 20px 0;
}
.page-404 p {
  font-size: 16px;
  color: #666;
  margin: 0 0 40px 0;
  line-height: 1.6;
}
.page-404 a {
  display: inline-block;
  padding: 12px 24px;
  margin: 0 8px 20px 8px;
  background-color: #121212;
  color: white;
  text-decoration: none;
  border-radius: 4px;
  font-weight: 600;
  min-width: 140px;
}
.page-404 a:hover {
  background-color: #333;
}
.page-404 a.secondary {
  background-color: white;
  border: 2px solid #121212;
  color: #121212;
}
.search-box {
  background-color: #f5f5f5;
  padding: 30px;
  border-radius: 8px;
  margin-top: 40px;
}
.search-box h3 {
  margin: 0 0 20px 0;
  font-size: 18px;
}
.search-box form {
  display: flex;
  gap: 10px;
}
.search-box input {
  flex: 1;
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 4px;
  font-size: 14px;
}
.search-box button {
  padding: 10px 20px;
  background-color: #121212;
  color: white;
  border: none;
  border-radius: 4px;
  font-weight: 600;
  cursor: pointer;
}
@media (max-width: 768px) {
  .page-404 { margin: 40px auto; padding: 20px 15px; }
  .page-404 h1 { font-size: 48px; }
  .page-404 h2 { font-size: 24px; }
  .page-404 a { display: block; margin: 10px 0; }
  .search-box form { flex-direction: column; }
  .search-box input { width: 100%; }
  .search-box button { width: 100%; }
}
</style>

<div class="page-404">
  <h1>404</h1>
  <h2>Page Not Found</h2>
  <p>The page you are looking for could not be found.</p>

  <div class="search-box">
    <h3>Search</h3>
    <form onsubmit="return false;">
      <input type="text" name="q" placeholder="Search products..." />
      <button type="submit">Search</button>
    </form>
  </div>
</div>
