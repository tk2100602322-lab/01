{
  "name": "Announcement",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "FREE SHIPPING on all orders over $100"
    },
    {
      "type": "color",
      "id": "announcement_bg_color",
      "label": "Background color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "url",
      "id": "announcement_url",
      "label": "Link URL"
    }
  ]
}

{% stylesheet %}
  .announcement {
    background-color: {{ section.settings.announcement_bg_color }};
    color: {{ section.settings.announcement_text_color }};
    padding: 1rem;
    text-align: center;
    font-weight: 600;
    text-decoration: none;
    display: block;
    transition: opacity 0.3s ease;
  }

  .announcement:hover {
    opacity: 0.9;
  }
{% endstylesheet %}

{% if section.settings.announcement_url %}
  <a href="{{ section.settings.announcement_url }}" class="announcement">
    {{ section.settings.announcement_text }}
  </a>
{% else %}
  <div class="announcement">
    {{ section.settings.announcement_text }}
  </div>
{% endif %}
