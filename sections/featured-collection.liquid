{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Featured Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ]
}

{% stylesheet %}
  .featured-collection {
    padding: 3rem 2rem;
  }

  .featured-collection h2 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .product-item {
    border: 1px solid #e5e5e5;
    border-radius: 4px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .product-item:hover {
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }

  .product-image {
    width: 100%;
    height: 250px;
    object-fit: cover;
  }

  .product-info {
    padding: 1rem;
  }

  .product-title {
    font-weight: bold;
    margin-bottom: 0.5rem;
  }

  .product-price {
    color: #121212;
    font-weight: bold;
  }
{% endstylesheet %}

<div class="featured-collection">
  <h2>{{ section.settings.title }}</h2>
  {% if section.settings.featured_collection != blank %}
    <div class="products-grid">
      {% for product in section.settings.featured_collection.products limit: section.settings.products_count %}
        <div class="product-item">
          <img class="product-image" src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title }}">
          <div class="product-info">
            <div class="product-title">{{ product.title }}</div>
            <div class="product-price">{{ product.price | money }}</div>
            <a href="{{ product.url }}" class="button">View</a>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>
