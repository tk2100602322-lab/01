{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What Our Customers Say"
    },
    {
      "type": "range",
      "id": "testimonial_count",
      "label": "Number of testimonials",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Customer Name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Author role/title",
          "default": "Verified Buyer"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Testimonial text",
          "default": "This product is amazing! I'm very satisfied with the quality and service."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Author image"
        }
      ]
    }
  ]
}

{% stylesheet %}
  .testimonials {
    padding: 4rem 2rem;
    background-color: {{ settings.colors_background_2 }};
  }

  .testimonials-title {
    text-align: center;
    margin-bottom: 3rem;
    font-size: 2.5rem;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .testimonial-card {
    background-color: white;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .testimonial-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    transform: translateY(-4px);
  }

  .testimonial-rating {
    margin-bottom: 1rem;
    color: #ffc107;
  }

  .testimonial-rating .star {
    font-size: 1.2rem;
  }

  .testimonial-content {
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #666;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .testimonial-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    overflow: hidden;
    background-color: #e5e5e5;
  }

  .testimonial-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonial-info h4 {
    margin: 0;
    font-size: 1rem;
  }

  .testimonial-info p {
    margin: 0;
    font-size: 0.85rem;
    color: #999;
  }
{% endstylesheet %}

<div class="testimonials">
  <h2 class="testimonials-title">{{ section.settings.title }}</h2>
  <div class="testimonials-grid">
    {% for block in section.blocks limit: section.settings.testimonial_count %}
      <div class="testimonial-card">
        <div class="testimonial-rating">
          {% for i in (1..block.settings.rating) %}
            <span class="star">★</span>
          {% endfor %}
          {% for i in (1..5 | minus: block.settings.rating) %}
            <span class="star">☆</span>
          {% endfor %}
        </div>
        <p class="testimonial-content">{{ block.settings.content }}</p>
        <div class="testimonial-author">
          {% if block.settings.avatar %}
            <div class="testimonial-avatar">
              <img src="{{ block.settings.avatar | image_url: width: 100 }}" alt="{{ block.settings.author }}">
            </div>
          {% endif %}
          <div class="testimonial-info">
            <h4>{{ block.settings.author }}</h4>
            <p>{{ block.settings.role }}</p>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
