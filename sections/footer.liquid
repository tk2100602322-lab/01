{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "© 2024 Your Store. All rights reserved."
    }
  ]
}

{% stylesheet %}
  .footer {
    background-color: #121212;
    color: white;
    padding: 3rem 2rem;
    text-align: center;
    border-top: 1px solid #e5e5e5;
  }
{% endstylesheet %}

<footer class="footer">
  <p>{{ section.settings.footer_text }}</p>
  <div class="footer-links">
    <a href="/policies/privacy-policy">{{ 'policies.privacy_policy' | t }}</a> |
    <a href="/policies/terms-of-service">{{ 'policies.terms_of_service' | t }}</a>
  </div>
</footer>
